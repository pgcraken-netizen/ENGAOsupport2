# ============================================================
# えんがお 介護記録支援システム — 環境変数設定例
# このファイルを .env.local にコピーして値を設定してください
# ============================================================

# ---- Supabase ------------------------------------------------
# Supabase プロジェクトの「Settings > API」から取得
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---- LINE Bot ------------------------------------------------
# LINE Developers コンソール「Messaging API」タブから取得
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ---- LINE LIFF (ミニアプリ) ----------------------------------
# LINE Developers コンソール「LIFF」タブで作成したアプリのID
NEXT_PUBLIC_LIFF_ID=1234567890-xxxxxxxx

# ---- OpenAI (AI申し送り生成) ---------------------------------
OPENAI_API_KEY=sk-...
# デフォルト: gpt-4o-mini（省略可）
OPENAI_MODEL=gpt-4o-mini

# ---- Cron 認証 -----------------------------------------------
# Vercel Cron Jobs のリクエストを検証するシークレット（任意の文字列）
CRON_SECRET=your-random-secret-here
