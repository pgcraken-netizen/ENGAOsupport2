# LINE LIFF（スタッフ記録アプリ）
NEXT_PUBLIC_LIFF_ID=1234567890-xxxxxxxx

# LINE Messaging API（旧LINEBot連携）
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# OpenAI（AI申し送り生成）
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=gpt-4o

# App
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
CRON_SECRET=your_random_cron_secret

# ===================================
# LIFF設定手順
# ===================================
# 1. LINE Developers Console で LIFFアプリを作成
#    - エンドポイントURL: https://your-app.vercel.app/liff
#    - スコープ: profile, openid
#    - ボットリンク機能: オン (任意)
# 2. 発行されたLIFF IDを NEXT_PUBLIC_LIFF_ID に設定
# 3. Supabase で migrations/002_liff.sql を実行
# ===================================
